@model WinLossByProducts.Model.WinLossByProductsInfo
@using WinLossByProducts.Extensions
<div>
    <div>
        Dear,
    </div>
    <br/>
   <table cellspacing="0" rules="all" border="1" id="display" style="border-color:#c5c5c5; border-style:Solid;border-collapse:collapse;font-size:10pt; font-family:Tahoma, Arial, Verdana, Sans-Serif;">
        <caption style="font-weight:bold; color:#538DD5; font-size:15px; margin-bottom:10px;">@Model.Date</caption>
        <thead>
            <tr style="height: 25px;background-color:#3C5EA5; color: #FFFFFF; font-weight: bold;">
                <th style="width:150px;">Product</th>
                <th style="width:120px;">Win/Loss</th>
                <th style="width:180px;">Month to Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Sportbook)
            {
                <tr style="height: 25px;">
                    <td style="text-align:left;">@item.ProductName</td>
                    <td style="text-align:right;">@NumberFormatExtension.DecimalNumberFormat(@item.WinLoss)</td>
                    <td style="text-align:right;">@NumberFormatExtension.DecimalNumberFormat(@item.MonthToDateWinLoss)</td>
                </tr>
            }
            @if (Model.SportbookTotal != null)
            {
                <tr style="height: 25px; background-color:#D8E4BC; text-align:right; font-weight:bold;">
                    <td>@Model.SportbookTotal.ProductName</td>
                    <td>@NumberFormatExtension.DecimalNumberFormat(@Model.SportbookTotal.WinLoss)</td>
                    <td>@NumberFormatExtension.DecimalNumberFormat(@Model.SportbookTotal.MonthToDateWinLoss)</td>
                </tr>
            }
            @foreach (var item in Model.ThirdPartySport)
            {
                if (@item.GroupName.ToLower() == "partners")
                {
                    <tr style="height: 25px;font-style:italic;color:#C0C0C0;">
                        <td style="text-align:left;">@item.ProductName</td>
                        <td style="text-align:right;">@NumberFormatExtension.DecimalNumberFormat(@item.WinLoss)</td>
                        <td style="text-align:right;">@NumberFormatExtension.DecimalNumberFormat(@item.MonthToDateWinLoss)</td>
                    </tr>
                }
                else
                {
                    <tr style="height: 25px;">
                        <td style="text-align:left; ">@item.ProductName</td>
                        <td style="text-align:right; ">@NumberFormatExtension.DecimalNumberFormat(@item.WinLoss)</td>
                        <td style="text-align:right; ">@NumberFormatExtension.DecimalNumberFormat(@item.MonthToDateWinLoss)</td>
                    </tr>
                }
            }
            @if (Model.Total != null)
            {
                <tr style="height: 25px;background-color:#C3D79B; text-align:right; font-weight:bold;">
                    <td>@Model.Total.ProductName</td>
                    <td>@NumberFormatExtension.DecimalNumberFormat(@Model.Total.WinLoss)</td>
                    <td>@NumberFormatExtension.DecimalNumberFormat(@Model.Total.MonthToDateWinLoss)</td>
                </tr>
            }
        </tbody>
   </table>
   <br />
    <div>
        Regards.
    </div>
</div>
