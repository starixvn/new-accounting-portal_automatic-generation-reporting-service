    <add key="RunAtMinutes" value="30"/>
    <add key="SQLiteDBPath" value="Data Source=D:\SQLite\NAP-Report\NAP-Report.s3db;Version=3;"/>
    <add key="Retry" value="5"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="ForceRunning" value="1"/>
    <add key="WinlostDateForceRunning" value="05-01-2014"/><!--MM-DD-YYYY-->
    <add key="ExportDataDirectory" value="D:\ExcelFiles"/>
    <add key="RemoteRefURL" value="tcp://10.18.200.209:8888/CallGetRefFunction"/>
  </appSettings>
  <connectionStrings>
    <add name="DBACC.bodb02.bodbAdminNet" connectionString="packet size=4096; Data Source=10.18.200.232;Asynchronous Processing=true;Initial Catalog=bodb02;integrated security=false; User ID=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient"/>
